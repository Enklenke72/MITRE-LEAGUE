rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rol de quien hace el pedido, leído de usuarios/{uid} ("coordinador" o "staff").
    // Sin sesión o sin documento de rol, get() falla y la regla deniega.
    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }
    function esStaff() {
      return request.auth != null && rol() in ['staff', 'coordinador'];
    }
    function esCoordinador() {
      return request.auth != null && rol() == 'coordinador';
    }

    // Rol de cada persona. Se carga a mano desde la consola de Firebase (que no pasa por
    // estas reglas): desde la web nadie escribe acá y cada uno lee solo su documento.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Lo que ve cualquier visitante de la web. Los jugadores acá solo tienen nombre,
    // dorsal, foto, goles e Instagram; el DNI va reemplazado por un código.
    match /equipos/{id} { allow read: if true; allow write: if esStaff(); }
    match /partidos/{id} { allow read: if true; allow write: if esStaff(); }
    match /sanciones/{id} { allow read: if true; allow write: if esStaff(); }
    match /noticias/{id} { allow read: if true; allow write: if esStaff(); }
    match /albumes/{id} { allow read: if true; allow write: if esStaff(); }
    match /sponsors/{id} { allow read: if true; allow write: if esStaff(); }
    match /notificaciones/{id} { allow read: if true; allow write: if esStaff(); }
    match /crucesPlayoffs/{id} { allow read: if true; allow write: if esStaff(); }
    match /config/{id} { allow read: if true; allow write: if esStaff(); }
    // Copia de todo lo anterior en 4 documentos, que arma el panel: la web pública lee solo estos.
    match /resumen/{id} { allow read: if true; allow write: if esStaff(); }

    // Datos personales de los jugadores (DNI, ficha médica, contactos de emergencia),
    // tesorería del día a día y avisos internos: solo staff y coordinador.
    match /equiposPrivado/{id} { allow read, write: if esStaff(); }
    match /tesoreriaPartidos/{id} { allow read, write: if esStaff(); }
    // Sin uso desde el 29/09/2026 (el valor de inscripción pasó a configCoordinador).
    match /configStaff/{id} { allow read, write: if esStaff(); }
    match /avisosStaff/{id} { allow read, write: if esStaff(); }

    // Sal para los códigos de DNI: se crea una sola vez y no se cambia (si cambiara,
    // los códigos ya guardados en partidos y sanciones dejarían de coincidir).
    match /privado/claves {
      allow read, create: if esStaff();
      allow update, delete: if false;
    }

    // Solo el coordinador: inscripciones (con sus beneficios), egresos, balance, la calculadora
    // de arancel y el valor de inscripción por jugador (en configCoordinador).
    match /tesoreriaInscripciones/{id} { allow read, write: if esCoordinador(); }
    match /egresos/{id} { allow read, write: if esCoordinador(); }
    match /configCoordinador/{id} { allow read, write: if esCoordinador(); }

    // Caja por Fecha: el staff registra cada pago que marca, pero solo el coordinador la ve.
    match /cajaMovimientos/{id} {
      allow create: if esStaff();
      allow read, update, delete: if esCoordinador();
    }

    // Historial de cambios: cada uno agrega sus entradas firmadas con el email de su sesión, y solo
    // el coordinador las lee o las borra ("Vaciar Historial"). Nadie las edita.
    match /historialCambios/{id} {
      allow create: if esStaff() && request.resource.data.email == request.auth.token.email;
      allow read, delete: if esCoordinador();
      allow update: if false;
    }
  }
}
